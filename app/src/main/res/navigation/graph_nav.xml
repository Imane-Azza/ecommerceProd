<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/graph_nav"
    app:startDestination="@id/onBoardingFragment">

    <fragment
        android:id="@+id/signinFragment"
        android:name="com.example.ecommerceprod.ui.signinFragment"
        android:label="fragment_signin"
        tools:layout="@layout/fragment_signin" >
        <action
            android:id="@+id/action_signinFragment_to_homePageFragment"
            app:destination="@id/homePageFragment" />
        <action
            android:id="@+id/action_signinFragment_to_signupFragment"
            app:destination="@id/signupFragment" />
        <action
            android:id="@+id/action_signinFragment_to_itemProductFragment"
            app:destination="@id/itemProductFragment" />
    </fragment>
    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.ecommerceprod.ui.signupFragment"
        android:label="fragment_signup"
        tools:layout="@layout/fragment_signup" >
        <action
            android:id="@+id/action_signupFragment_to_signinFragment"
            app:destination="@id/signinFragment" />
        <action
            android:id="@+id/action_signupFragment_to_homePageFragment"
            app:destination="@id/homePageFragment" />
        <action
            android:id="@+id/action_signupFragment_to_itemProductFragment"
            app:destination="@id/itemProductFragment" />
    </fragment>


    <fragment
        android:id="@+id/onBoardingFragment"
        android:name="com.example.ecommerceprod.ui.onBoardingFragment"
        android:label="fragment_on_boarding"
        tools:layout="@layout/fragment_on_boarding" >
        <action
            android:id="@+id/action_to_signUpFragment"
            app:destination="@id/signupFragment" />
        <action
            android:id="@+id/action_to_homeFragment"
            app:destination="@id/homePageFragment" />
        <action
            android:id="@+id/action_onBoardingFragment_to_itemProductFragment"
            app:destination="@id/itemProductFragment" />
    </fragment>
    <fragment
        android:id="@+id/homePageFragment"
        android:name="com.example.ecommerceprod.ui.HomePageFragment"
        android:label="fragment_home_page"
        tools:layout="@layout/fragment_home_page" >
        <action
            android:id="@+id/action_homePageFragment_to_onBoardingFragment"
            app:destination="@id/onBoardingFragment" />
        <action
            android:id="@+id/action_homePageFragment_to_signinFragment"
            app:destination="@id/signinFragment" />

    </fragment>
    <fragment
        android:id="@+id/itemProductFragment"
        android:name="com.example.ecommerceprod.ui.ItemProductFragment"
        android:label="fragment_item_product"
        tools:layout="@layout/fragment_item_product" >
        <action
            android:id="@+id/action_itemProductFragment_to_productDetailsFragment"
            app:destination="@id/productDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/productDetailsFragment"
        android:name="com.example.ecommerceprod.ui.ProductDetailsFragment"
        android:label="fragment_product_details"
        tools:layout="@layout/fragment_product_details" >
        <action
            android:id="@+id/action_productDetailsFragment_to_itemProductFragment"
            app:destination="@id/itemProductFragment" />
    </fragment>


</navigation>